<?xml version='1.0' encoding='utf-8'?>
<widget android-versionCode="313" id="de.christian_steinert.tibetandict" version="0.0.28" versionCode="313" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>TibetanDictionary</name>
    <description>A Tibetan Dictionary app that supports Wylie input, uses Tibetan script and comes with various dictionaries.</description>
    <author email="dictionary@christian-steinert.de" href="http://www.christian-steinert.de">Christian Steinert</author>
    <content src="index.html" />
    <access origin="*" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="36" />
    <framework src="androidx.core:core:1.12.0" />
    
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/android/splash/logo512_vectorized.xml" />

    <config-file parent="/*" target="AndroidManifest.xml">
        <supports-screens android:anyDensity="true" android:largeScreens="true" android:normalScreens="true" android:resizeable="true" android:smallScreens="true" android:xlargeScreens="true" />
        <uses-permission android:name="android.permission.INTERNET" />
        <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    </config-file>
    <edit-config file="AndroidManifest.xml" mode="merge" target="/manifest/application">
        <application android:icon="@mipmap/icon" android:enableOnBackInvokedCallback="false"  />
    </edit-config>
    <config-file parent="/manifest/application" target="AndroidManifest.xml">
        <activity-alias android:exported="true" android:label="Tib -&gt; Eng" android:name=".ShareTibetanActivity" android:targetActivity=".MainActivity">
            <intent-filter android:label="Tib -&gt; Eng">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="de.christian_steinert.tibetandict.CATEGORY_SHARE_LANG_TIB" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data android:name="searchLanguage" android:value="tib" />
        </activity-alias>
        <activity-alias android:exported="true" android:label="Eng -&gt; Tib" android:name=".ShareEnglishActivity" android:targetActivity=".MainActivity">
            <intent-filter android:label="Eng -&gt; Tib">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="de.christian_steinert.tibetandict.CATEGORY_SHARE_LANG_EN" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data android:name="searchLanguage" android:value="en" />
        </activity-alias>
        <activity-alias android:exported="true" android:label="Skt -&gt; Tib" android:name=".ShareSanskritActivity" android:targetActivity=".MainActivity">
            <intent-filter android:label="Skt -&gt; Tib">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="de.christian_steinert.tibetandict.CATEGORY_SHARE_LANG_SKT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data android:name="searchLanguage" android:value="skt" />
        </activity-alias>
    </config-file>
    <platform name="android">
        <preference name="Debuggable" value="true" />

        <!-- Enable R8 minification and resource shrinking -->
        <resource-file src="proguard-rules.pro" target="app/proguard-rules.pro" />
        <resource-file src="build-extras.gradle" target="app/build-extras.gradle" />
    </platform>
</widget>
